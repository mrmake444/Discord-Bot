# Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click your server -> Copy Server ID (needs Developer Mode on).
# Scopes slash commands to this one server so they register instantly.
GUILD_ID=

# https://tracker.gg/developers
TRN_API_KEY=

# Two-way Discord <-> Minecraft chat bridge. Channel ID to mirror chat in
# both directions; leave blank/0 to disable. Requires the "Message Content"
# privileged intent enabled on the Bot page in the Developer Portal.
MC_CHAT_CHANNEL_ID=

# Also relay player join/leave lines into the bridge channel. Default true.
# MC_BRIDGE_JOIN_LEAVE=true
